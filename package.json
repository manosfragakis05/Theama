{
  "name": "theama",
  "type": "module",
  "scripts": {
    "vite:dev": "vite --port 5173 --strictPort --host 127.0.0.1",
    "wrangler:dev": "wrangler pages dev public --port 8788 --binding VITE_DEV_ORIGIN=http://127.0.0.1:5173 --compatibility-date=2026-06-18",
    "dev": "npm-run-all --parallel vite:dev wrangler:dev",
    "build": "vite build",
    "test:torbox": "node --experimental-vm-modules --test tests/torbox*.test.js",
    "test:play-on-add": "node --experimental-vm-modules --test tests/play-on-add.test.js",
    "test:media-requests": "node --experimental-vm-modules --test tests/media-requests.test.js",
    "test:addon-library": "node --experimental-vm-modules --test tests/addon-library.test.js",
    "preview": "vite preview"
  },
  "devDependencies": {
    "autoprefixer": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "vite": "^6.4.2",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "^4.129.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.2",
    "@viren070/parse-torrent-title": "^0.9.1"
  }
}
